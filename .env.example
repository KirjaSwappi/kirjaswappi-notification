# Kirjaswappi Notification Service Configuration

# Server Ports
HTTP_PORT=8080
GRPC_PORT=50051

# Logging
LOG_LEVEL=info

# Security
ALLOWED_ORIGINS=https://kirjaswappi.fi,https://app.kirjaswappi.fi
# Set a strong random API key before enabling authenticated access
API_KEY=
# Set a strong random JWT secret before issuing or validating tokens
JWT_SECRET=

# Shutdown
SHUTDOWN_TIMEOUT=30